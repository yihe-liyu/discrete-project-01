#!/usr/bin/env python

# N1 探针：最小 extension，显式 api_version=4.7（godot-cpp v10）
env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "testproj/bin/libhello{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
