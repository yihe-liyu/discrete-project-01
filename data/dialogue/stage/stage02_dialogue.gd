extends RefCounted
## 一面对话

const REIMU := preload("res://data/dialogue/profile/reimu_profile.tres")
const MARISA := preload("res://data/dialogue/profile/marisa_profile.tres")
const FENG := preload("res://data/dialogue/profile/feng_profile.tres")


static func 灵梦战斗前() -> DialogueSteps:
	var 对话 := DialogueSteps.new()
	对话.event("boss_enter")  # Boss 进场
	对话.wait(1.0)
	var 峰星恒 = 对话.enter(FENG, Vector2(550, 230))
	峰星恒.portrait("笑").line("怎么样？\n白天的星星好看吗？")
	var 灵梦 = 对话.enter(REIMU, Vector2(50, 230))
	灵梦.portrait("叹气").line("又是一个奇怪的人吗…\n白天哪来的星星啊？")
	峰星恒.portrait("通常").line("星星就在那里啊。\n白天看不见，只是被太阳的光抢了风头。")
	灵梦.portrait("通常")
	峰星恒.portrait("笑").line("只要天暗下来，星星的光不就能被看见了吗？")
	峰星恒.portrait("笑").line("就像现在，天因为日食变黑了。")
	峰星恒.portrait("通常").line("能看见星星了吗？")
	灵梦.portrait("通常").line("…")
	灵梦.portrait("疑惑").line("…")
	灵梦.line("现在倒是天黑，但是没看见星星啊？")
	峰星恒.portrait("尴尬").line("（没看见？她不会是直接遮黑的吧……）")
	灵梦.portrait("通常").line("你不会打算就在这和我聊星星吧？")
	峰星恒.portrait("笑").line("当然不。")
	峰星恒.portrait("通常").line("我是峰星恒，来自外界的人类，受委托来给你引路，并且带你到一些地方。")
	对话.event("display_name")
	峰星恒.portrait("笑").line("她说之后可以让我在结界里看星星。")
	灵梦.portrait("震惊").line("你说什么？\n外界的人类！？")
	峰星恒.portrait("尴尬").line("人类没有那么可怕吧…？")
	灵梦.portrait("生气").line("谁把你带进来的！？")
	峰星恒.portrait("尴尬").line("我就是带你去见她的……")
	峰星恒.portrait("笑").line("但不是马上。\n所以不用着急，可以沿途看看好看的星星……")
	峰星恒.portrait("尴尬").line("不对，你现在看不见星星……")
	峰星恒.portrait("笑").line("那就看风景吧，这个异变不是什么大事，毕竟什么也没扰乱不是吗？")
	灵梦.portrait("生气").line("不是大事！？\n不仅有日食异变，现在连外界的人类都进来了？")
	灵梦.line("我还看风景？")
	峰星恒.portrait("尴尬").line("冷静一点冷静一点。\n不冷静的话，身处旅途的时候会很难受的。")
	灵梦.line("少说废话！\n你究竟知道什么？")
	对话.event("bgm_switch")
	峰星恒.line("我只是带你去一些地方的啊。")
	灵梦.line("就算是人类也不能在我面前装糊涂！")
	峰星恒.line("别打啊！等等……")
	对话.event("boss_fight")  # 行间事件：最后一句说完 → Boss 开战
	return 对话


static func 灵梦战斗后_高记忆值() -> DialogueSteps:
	var 对话 := DialogueSteps.new()
	var 灵梦 = 对话.enter(REIMU, Vector2(50, 230))
	var 峰星恒 = 对话.enter(FENG, Vector2(550, 230))
	灵梦.portrait("通常")
	峰星恒.portrait("战败").line("哇哇哇……\n说了别打啊……")
	峰星恒.line("你原来不是人类吗……")
	灵梦.portrait("通常").line("胡说什么。\n赶紧带我去见委托你的人。")
	峰星恒.line("根本没听我说话嘛……\n不能马上……")
	灵梦.portrait("叹气").line("看来只能缓慢前进了吗……")
	灵梦.portrait("通常")
	峰星恒.line("游刃有余的躲避，应该算没忘掉什么吧。")
	峰星恒.line("那就是要带你去人间之里了。")
	灵梦.portrait("疑惑").line("为什么带我去那里？")
	峰星恒.line("唔，这个，她没说。")
	灵梦.portrait("通常")
	峰星恒.line("总之，准备好。")
	峰星恒.line("要到了哦。")
	对话.exit(REIMU)
	对话.exit(FENG)
	对话.wait(1.0)
	对话.event("stage_end")
	return 对话


