[sub_resource type="Resource" id="Resource_mnbxo"]
script = ExtResource("1")
music_id = 17
title = "朝夕之阳，在远在洋"
comment = "朝夕之阳，在远在洋
ＥＸ面道中的音乐
日出时破裂的记忆界，晨光与妖精纷飞，新生与死亡交织，弹幕不再是这里唯一可见的记忆。
我希望能做出日出前后的氛围变化，以及一丝无奈的“那又如何”的感觉。
是啊，世界就是那样的运行着。"
bgm_key = "music_17"
is_unlocked = true
metadata/_custom_type_script = "uid://be08pe8s61ass"

[sub_resource type="Resource" id="Resource_immyd"]
script = ExtResource("1")
music_id = 18
title = "以空为核，抽丝剥茧"
comment = "以空为核，抽丝剥茧
似新存的主题曲
这首曲子并没有如名字那样给人柔软、温和的感觉，反而是比较的激烈，她从未知的记忆里醒来，支撑她活下去的，就是记忆、意象、意义本身。
曲子重复很多，甚至结构上也只有两段，所谓的高潮段就是整整后面半段，我不想赋予这种贫瘠太多意义——那是没有意义的。"
bgm_key = "music_18"
is_unlocked = true
metadata/_custom_type_script = "uid://be08pe8s61ass"

