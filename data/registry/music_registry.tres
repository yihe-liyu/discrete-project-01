[ext_resource type="Script" uid="uid://cn2j4wrr5x2lm" path="res://scripts/data/music_registry.gd" id="2"]

[sub_resource type="Resource" id="MusicRecord_01"]
script = ExtResource("1")
music_id = 1
title = "无缘故之回"
comment = "无缘故之回
标题曲
较为平平的音乐，即使有一些高昂，那也是无缘故的。
毕竟，从未谋面，自然没有回忆；没有回忆，那么所谓“回”也自然是无缘故的了。
一面之缘的感情的起伏又有多少真实呢。"
bgm_key = "music_1"
is_unlocked = true

[sub_resource type="Resource" id="MusicRecord_02"]
script = ExtResource("1")
music_id = 2
title = "夜间漫步"
comment = "夜间漫步
１面道中的音乐
哎呀，明明是日食，却还取名为“夜间”漫步，但那也只是因为天太黑了呢。
于是就这样，主要是漫步的感觉了，夜不夜间的不是重点了，反正人类也不是能够每时每刻都生活在光明里的吧。
总之异变就是这样的不是吗？"
bgm_key = "music_2"
is_unlocked = true

[sub_resource type="Resource" id="Resource_n7uf7"]
script = ExtResource("1")
music_id = 3
title = "洞窟蝙蝠"
comment = "洞窟蝙蝠
卡摩瑞的主题曲
听起来笨笨的，虽然其实不是，只是呆呆的，还是有一些逻辑能力的。
曲子的后面……是某种对回音的模仿，虽然就是两个一样的音轨错开。
不过这种氛围至少说明了她真的没有那么大的威胁。"
bgm_key = "music_3"
is_unlocked = true
metadata/_custom_type_script = "uid://be08pe8s61ass"

[sub_resource type="Resource" id="MusicRecord_03"]
script = ExtResource("1")
music_id = 7
title = "就在那里的不思议宇宙"
comment = "就在那里的不思议宇宙
３Ｂ面道中的音乐
改自《东方绀珠传》的三面道中音乐——《飞翔于宇宙的不可思议巫女》
这里是梦世界，只能无地飞翔的地方，但并不是只有轻盈一种可能，所以我尝试做成与梦反过来的“沉”，但保留了“悲”。
当然，没有终点的“沉”，会自然的产生“悲”。"
bgm_key = "music_7"
is_unlocked = true

[sub_resource type="Resource" id="Resource_lemic"]
script = ExtResource("1")
music_id = 10
title = "寂寥记忆界"
comment = "寂寥记忆界
４面道中的音乐
使用了小号，试图吹出宏大以表达寂寥，但最后还是停下了，引出了缥缈的氛围就足够了。
记忆界，一个多么空的地方，没有活物，只有空虚的自然，妖精不知道这个地方，也就不能为这里带来生命；记忆体则又只是被撕裂出来的容器。
活与死，和动与静、知与盲都没有直接关系。
事物作为事物，依旧依靠着——这是什么；这不是什么。"
bgm_key = "music_10"
is_unlocked = true
metadata/_custom_type_script = "uid://be08pe8s61ass"

[sub_resource type="Resource" id="MusicRecord_04"]
script = ExtResource("1")
music_id = 12
title = "不尽记忆的天空"
comment = "不尽记忆的天空
５面道中的音乐
使用了小号，试图吹出宏大以表达天空，这次没有停，天空没有尽头，至少在飞出去之前。
记忆界，一个多么满的地方，充满记忆，到处是生机的基石，一旦从悬着的天空中掉下来，就会露出内部的流光溢彩；那外部的石壳难道是束缚吗？
内与外，和是与否、同与异都没有直接关系。
想要认识事物，也不过——要真识它；不要假定它。"
bgm_key = "music_12"
is_unlocked = true

[sub_resource type="Resource" id="Resource_p7x6n"]
script = ExtResource("1")
music_id = 16
title = "忘不了，与生俱来的未来"
comment = "忘不了，与生俱来的未来
片律的主题曲
"
bgm_key = "music_16"
is_unlocked = true
