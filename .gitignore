# Godot 4+ specific ignores
.godot/
.trae/
/android/

# 编辑器本地配置（C/C++ Runner 等含机器绝对路径，不入库）
.vscode/
a.out

# npm
node_modules/
package-lock.json
package.json

# 本地恢复备份（勿提交）
.recovery_backup/

# Godot/编辑器临时 object store 工作目录
.objstore_work*/
.xdg_data/

# 临时工作清单（做完一条删一条；不进库）
TODO_TEMP.md

# GDExtension 构建产物（.so / .gdextension 都随构建生成，不入库）：
# 未构建 = 无扩展 = 游戏照跑 GDScript；构建后才加载原生。
# godot-cpp 是子模块，其产物由子模块自身 .gitignore 管。
gdextension/bin/
gdextension/danmaku_kernel.gdextension
gdextension/danmaku_kernel.gdextension.uid
gdextension/src/*.os
gdextension/src/*.o
gdextension/.sconsign.dblite
gdextension/.sconsign*
